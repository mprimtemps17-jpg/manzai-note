{
  "name": "manzai-note",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.12"},
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "typecheck": "tsc --noEmit",
    "test:api": "node --disable-warning=ExperimentalWarning --test tests/api.test.mjs",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run test:api && npm run test:browser",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.72.0"
  },
  "dependencies": {"jose": "^6.2.0"}
}
