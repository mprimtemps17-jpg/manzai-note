{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manzai-note",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "manzai-note", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "AI_LIMITER", "namespace_id": "1001", "simple": { "limit": 4, "period": 60 } }
  ]
}
